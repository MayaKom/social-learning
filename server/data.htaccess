# Upload this file into the server's data/ folder and rename it to ".htaccess".
# It stops anyone from downloading the data files through a web browser
# (save.php can still write to the folder).

# Apache 2.4
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
# Apache 2.2
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
